    EXTE M7_UNO_LE M7_UNO_LE -lt 0.096 -abut -lt 90 -metric opposite -output region;
}

RULE METAL47.A.1 {
    CAPTION Minimum M7 area 0.01;
    AREA M7 -lt 0.01;
}

RULE METAL47.E.1.1 {
    CAPTION Minimum M7 enclosure of V6 0.015;
    ENC V6 M7 -lt 0.015 -abut lt 90 -single_point -output region;
}

RULE CAPMET.E.1 {
    CAPTION Minimum CMT enclosure of VT 0.08;
    ENC VT CMT -lt 0.08 -abut lt 90 -single_point -output region;
}

RULE CAPMET.E.2 {
