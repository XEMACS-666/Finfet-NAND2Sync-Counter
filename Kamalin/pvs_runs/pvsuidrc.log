EXTE CutM1_MASK1_eol CutM1_MASK1_eol -lt 0.08 -not_project -outputlayer cutm11_mask1_sp2_cutm1_not_project;
EXTE CutM1_MASK1_eol CutM1_MASK1_eol -lt 0.08 -project -lt 0.032 -outputlayer cutm11_mask1_sp2_cutm1_overlap;
