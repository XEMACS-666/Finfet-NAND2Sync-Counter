    COPY CutM11_all_w_2;
}

RULE CutM11.W.3 {
    CAPTION CUTM11.W.3: Maximum CutMetal length in the preferred metal direction <=1.0 um;
    COPY CutM11_all_w_3;
}

RULE METAL11.W.1 {
    CAPTION Minimum M1_all width 0.032;
    INTE M1_all M1_all -lt 0.032 -abut lt 90 -single_point -output region;
}

RULE METAL11.W.2 {
    CAPTION Maximum M1_all width 2.0;
    WITH_WIDTH M1_all -gt 2;
}

RULE METAL11.SP.1.1 {
    CAPTION Minimum M1_all to M1_all space 0.032;
    EXTE M1_all M1_all -lt 0.032 -abut lt 90 -single_point -output region;
}
ENC M1_all CutM1_all -lt 0.01 -single_point -output region -outputlayer CUTM11_e1_1;
EDGE_BOOLEAN -inside CutM1_all M1_all -outputlayer CutM1_inside_M1_all;
EDGE_EXPAND CutM1_inside_M1_all -inside_by 0.001 -outputlayer CutM1_inside_M1_all_edge;
RECT_CHK -not CutM1_inside_M1_all_edge -outputlayer CutM1_inside_M1_all_e1_2;
OR CUTM11_e1_1 CutM1_inside_M1_all_e1_2 -outputlayer CutM1_inside_M1_all_e1;

RULE CUTM11.E.1 {
    CAPTION Minimum CUTM11 extension beyond M1_all >= 0.01;
    COPY CutM11_e1_1;
}
WITH_WIDTH M1_all -ge 0.1 M1_all_ge0p100;
WITH_WIDTH M1_all_ge0p100 -ge 0.75 M1_all_ge0p750;
WITH_WIDTH M1_all_ge0p750 -ge 1.5 M1_all_ge1p500;
EXTE M1_all M1_all -lt 0.048 -abut lt 90 -single_point m1_link_sp21_m1;
EXTE M1_all M1_all_ge0p100 -lt 0.072 -abut lt 90 -single_point -project ge 0.32 m1_link_sp22_m1;
EXTE M1_all M1_all_ge0p750 -lt 0.112 -abut lt 90 -single_point -project ge 0.75 m1_link_sp23_m1;
EXTE M1_all M1_all_ge1p500 -lt 0.22 -abut lt 90 -single_point -project ge 1.5 m1_link_sp24_m1;
CONVEX_EDGE M1_all -eq 2 -with_length le 0.05 M1_all_end;
EXTE M1_all_end M1_all_end -lt 0.064 -abut lt 90 -single_point m1_link_sp41_m1;
DFM_COPY m1_link_sp21_m1 m1_link_sp22_m1 m1_link_sp23_m1 m1_link_sp24_m1 m1_link_sp41_m1 -outputlayer m1_all_links;
BALANCECOLOR M1_all m1_all_links -min_s 0.048 -keep_seed_color -wire -seed0 M1_MASK1_LOCK -seed1 M1_MASK2_LOCK -color0 M1_MASK1_ -color1 M1_MASK2_;
SELECT -interact M1_MASK1_LOCK M1_MASK2_ -outputlayer M1_MASK1_Conflict;
SELECT -interact M1_MASK2_LOCK M1_MASK1_ -outputlayer M1_MASK2_Conflict;

