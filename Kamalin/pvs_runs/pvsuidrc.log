}

RULE M1_MASK2_Conflict {
    COPY M1_MASK2_Conflict;
}
OR CutM1 CutM1_MASK1_UNLOCK CutM1_MASK2_UNLOCK -outputLayer CutM1_uncolored;
SELECT -interact CutM1_uncolored M1_MASK1_ -outputlayer CutM1_MASK1_colored;
SELECT -outside CutM1_uncolored CutM1_MASK1_colored -outputlayer CutM1_MASK2_colored;
OR CutM1_MASK1_colored CutM1_MASK1_LOCK -outputlayer CutM1_MASK1_;
OR CutM1_MASK2_colored CutM1_MASK2_LOCK -outputlayer CutM1_MASK2_;
SELECT -interact CutM1_MASK1_ M1_MASK2_ -outputlayer CutM1_MASK1_M1_MASK2_Conflict;
SELECT -interact CutM1_MASK2_ M1_MASK1_ -outputlayer CutM1_MASK2_M1_MASK1_Conflict;
SELECT -interact CutM1_MASK1_ CutM1_MASK2_ -outputlayer CutM1_MASK1_CutM1_MASK2_Conflict;
EXTE CutM1_MASK1_ CutM1_MASK2_ -lt 0.012 -abut lt 90 -single_point CutM11_sp4;

