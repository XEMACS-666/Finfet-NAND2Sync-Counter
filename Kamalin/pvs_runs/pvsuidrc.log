CONVEX_EDGE CutM1_MASK1_ -eq 2 -with_length -eq 0.032 -outputlayer CutM1_MASK1_eol;
CONVEX_EDGE CutM1_MASK1_ -eq 2 -with_length -ge 0.052 -outputlayer CutM1_MASK1_y_dir;
EXTE CutM1_MASK1_ CutM1_MASK1_ -lt 0.001 -single_point -outputlayer CutM1_MASK1_point_touch;
EXTE CutM1_MASK1_y_dir CutM1_MASK1_y_dir -lt 0.064 -outputlayer cutm1_mask1_sp1_cutm1;
