WITH_WIDTH M1_MASK1_ -ge 0.1 M1_mask1_ge0p100;
WITH_WIDTH M1_mask1_ge0p100 -ge 0.75 M1_mask1_ge0p750;
WITH_WIDTH M1_mask1_ge0p750 -ge 1.5 M1_mask1_ge1p500;
EXTE M1_MASK1_ M1_MASK1_ -lt 0.048 -abut lt 90 -single_point m1_mask1_sp21_m1;
