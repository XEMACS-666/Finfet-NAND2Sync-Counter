ANGLE CutM1_all -eq 90 CutM1_all_V;
ANGLE CutM1_all -eq 0 CutM1_all_H;
INTE CutM1_all_V CutM1_all_V -eq 0.032 -abut lt 90 -output negative1 -metric opposite -outputlayer CutM11_all_w_1;
EDGE_LENGTH CutM1_all_V -lt 0.052 -outputlayer CutM11_all_w_2;
EDGE_LENGTH CutM1_all_V -gt 1 -outputlayer CutM11_all_w_3;

RULE CutM11.W.1 {
